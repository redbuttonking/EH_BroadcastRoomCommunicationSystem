{
  "name": "eh-broadcast-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "firebase emulators:exec --project demo-eh-broadcast --only auth,database \"node scripts/local-preview.mjs\"",
    "local:admin": "node scripts/local-admin.mjs",
    "build": "tsc -b && vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "format:check": "prettier --check src scripts tests *.ts *.json",
    "test:firebase": "firebase emulators:exec --project demo-eh-broadcast --only database \"vitest run --config vitest.firebase.config.ts\"",
    "build:production": "node scripts/build-production.mjs",
    "backup:settings": "node scripts/backup-settings.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "basic-ftp": "6.2.3"
  }
}
