# Local preview uses the Firebase emulators. No billing/project account needed.
VITE_FIREBASE_EMULATORS=true

# For the actual Firebase Spark project, set the value above to false.
# Firebase web configuration identifiers are not room passwords or admin keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
